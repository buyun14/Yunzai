{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "app.js",
    "types/**/*.d.ts",
    "lib/**/*.js",
    "plugins/adapter/**/*.js",
    "plugins/system/**/*.js",
    "plugins/other/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "lib/modules",
    "resources",
    "renderers",
    "plugins/*/node_modules",
    "plugins/miao-plugin"
  ]
}
